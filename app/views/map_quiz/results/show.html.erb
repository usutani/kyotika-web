<div class="layout">
  <header class="page-header">
    <%= page_header_tag %>
    <p class="page-header__subtitle">地図クイズ結果</p>
  </header>

  <div class="quiz">
    <div class="quiz__score">
      <p class="quiz__score-number"><%= @score %> / <%= @total %></p>
      <div class="quiz__score-bar">
        <div class="quiz__score-fill" style="width: <%= (@total > 0 ? (@score.to_f / @total * 100).round : 0) %>%"></div>
      </div>
      <p class="quiz__score-percent">発見率 <%= @total > 0 ? (@score.to_f / @total * 100).round : 0 %>%</p>
    </div>

    <div class="nav-links nav-links--gap">
      <%= link_to "地図に戻る", map_quiz_path(resume: true), class: "btn btn--secondary" %>
    </div>

    <% if @spots.any? %>
      <div data-controller="pane">
        <div class="quiz__tabs" role="tablist">
          <button type="button" class="quiz__tab quiz__tab--active" data-pane-target="tab" data-action="click->pane#switch" data-pane-name="list" role="tab" aria-selected="true">一覧</button>
          <button type="button" class="quiz__tab" data-pane-target="tab" data-action="click->pane#switch" data-pane-name="found" role="tab" aria-selected="false">発見のみ (<%= @found_spots.size %>)</button>
          <button type="button" class="quiz__tab" data-pane-target="tab" data-action="click->pane#switch" data-pane-name="tags" role="tab" aria-selected="false">タグ別</button>
        </div>

        <div data-pane-target="pane" data-pane-name="list" role="tabpanel">
          <%= render "spots_table", spots: @spots %>
        </div>

        <div data-pane-target="pane" data-pane-name="found" role="tabpanel" hidden>
          <% if @found_spots.any? %>
            <%= render "spots_table", spots: @found_spots %>
          <% else %>
            <p class="empty-message">まだ発見はありません。きらめきを探してみましょう。</p>
          <% end %>
        </div>

        <div data-pane-target="pane" data-pane-name="tags" role="tabpanel" hidden>
          <% @tag_groups.each do |group| %>
            <h3 class="quiz__tag-heading"><%= group[:name] %></h3>
            <%= render "spots_table", spots: group[:spots] %>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="nav-links">
      <%= link_to "地図に戻る", map_quiz_path(resume: true), class: "btn btn--secondary" %>
    </div>
  </div>
</div>
