<turbo-frame id="map-quiz-question">
  <div class="quiz__question">
    <p><%= @landmark.question %></p>
  </div>

  <div id="map-quiz-answers" class="quiz__answers">
    <% (1..3).each do |n| %>
      <%= form_with url: map_quiz_answer_path, method: :post, class: "quiz__answer-form" do |f| %>
        <%= f.hidden_field :landmark_id, value: @landmark.id, id: "map-quiz-landmark-id-#{n}" %>
        <%= f.hidden_field :selected, value: n, id: "map-quiz-selected-#{n}" %>
        <button type="submit" class="btn quiz__answer-btn"><%= @landmark.send("answer#{n}") %></button>
      <% end %>
    <% end %>
  </div>
</turbo-frame>
