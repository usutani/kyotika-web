<div class="layout">
  <header class="page-header">
    <h1 class="page-header__title">ログイン</h1>
    <p class="page-header__subtitle">アカウントが必要な方は管理者にお問い合わせください</p>
  </header>

  <%= form_with(url: session_path, class: "form") do |f| %>
    <div class="form__group">
      <%= f.label :email_address, "メールアドレス" %>
      <%= f.email_field :email_address, value: params[:email_address], class: "form__control", autocomplete: "email" %>
    </div>

    <div class="form__group">
      <%= f.label :password, "パスワード" %>
      <%= f.password_field :password, class: "form__control", autocomplete: "current-password" %>
    </div>

    <div class="form__actions">
      <%= f.submit "ログイン", class: "btn btn--primary" %>
    </div>
  <% end %>
</div>
