<div class="layout">
  <header class="page-header">
    <h1 class="page-header__title">Invalid URLs</h1>
    <p class="page-header__subtitle">
      <% if @checked_at %>
        検証日: <%= @checked_at %>
      <% end %>
      （<%= @invalid_urls.count %>件）
    </p>
  </header>

  <% if @invalid_urls.any? %>
    <div class="table">
      <table class="data-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>名前</th>
            <th>調査結果の URL</th>
            <th>ステータス</th>
            <th></th>
            <th>DB の URL</th>
            <th>DB ステータス</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @invalid_urls.each do |item| %>
            <tr>
              <td class="data-table__cell--num"><%= item[:id] %></td>
              <td class="data-table__cell--name"><%= item[:name] %></td>
              <td class="data-table__cell--url"><%= link_to item[:url], item[:url], target: "_blank", rel: "noopener" %></td>
              <td class="data-table__cell--status">
                <span class="status-badge <%= status_class(item[:status]) %>">
                  <%= item[:status] %>
                </span>
              </td>
              <td class="data-table__cell--action"><%= link_to "編集", edit_landmark_path(item[:id]), class: "btn btn--edit" %></td>
              <td class="data-table__cell--url">
                <% if item[:db_url].present? %>
                  <%= link_to item[:db_url], item[:db_url], target: "_blank", rel: "noopener" %>
                <% end %>
              </td>
              <td class="data-table__cell--status">
                <% if item[:db_url_status].present? %>
                  <span class="status-badge <%= db_status_class(item[:db_url_status]) %>">
                    <%= db_status_label(item[:db_url_status]) %>
                  </span>
                  <small class="status-badge__checked-at"><%= item[:db_url_checked_at]&.strftime("%Y-%m-%d %H:%M") %></small>
                <% else %>
                  <span class="status-badge status-badge--unchecked">未チェック</span>
                <% end %>
              </td>
              <td class="data-table__cell--action">
                <%= form_with url: url_checks_path, method: :post, local: true do |f| %>
                  <%= f.hidden_field :landmark_id, value: item[:id] %>
                  <%= f.submit "再チェック", class: "btn btn--check" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="empty-message">Invalid URLs はありません。</p>
  <% end %>

  <div class="nav-links">
    <%= link_to "一覧に戻る", landmarks_path, class: "btn btn--secondary" %>
    <%= link_to "タグ一覧", tags_path, class: "btn btn--nav" %>
  </div>
</div>
