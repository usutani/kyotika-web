<% content_for :head do %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css">
<% end %>

<div class="layout">
  <header class="page-header">
    <%= page_header_tag %>
    <p id="map-quiz-subtitle" class="page-header__subtitle">地図クイズ（発見 <%= @found_ids.size %> / <%= @total %>）</p>
  </header>

  <div class="map-quiz" data-controller="map-quiz"
    data-map-quiz-spots-value="<%= h @spots.to_json %>"
    data-map-quiz-found-ids-value="<%= h @found_ids.to_json %>"
    data-map-quiz-hidden-ids-value="<%= h @hidden_ids.to_json %>"
    data-map-quiz-center-value="<%= h @center.to_json %>"
    data-map-quiz-zoom-value="<%= @zoom %>"
    data-map-quiz-fit-bounds-value="<%= @fit_bounds %>"
    data-map-quiz-resume-value="<%= @resume %>"
    data-map-quiz-question-url-value="<%= map_quiz_question_path %>">
    <p class="map-quiz__hint">地図をクリック/タップすると🐕がそこへ移動します。きらめき✨の近くで思い出のクイズが開きます。</p>

    <div class="map-quiz__canvas-wrap">
      <div class="map-quiz__canvas" data-map-quiz-target="canvas"></div>
      <div class="map-quiz__dog" data-map-quiz-target="dog" aria-hidden="true">🐕</div>
      <div class="map-quiz__toast" data-map-quiz-target="toast" role="status" aria-live="polite" hidden></div>
    </div>

    <div class="map-quiz__status" data-map-quiz-target="status" role="status"></div>

    <div class="map-quiz__modal" data-map-quiz-target="modal" hidden>
      <turbo-frame id="map-quiz-question" data-map-quiz-target="frame"></turbo-frame>
    </div>

    <div class="nav-links">
      <%= link_to "発見記録を見る", map_quiz_result_path, class: "btn btn--secondary" %>
      <%= form_with url: map_quiz_path, method: :delete, class: "map-quiz__reset-form" do %>
        <%= submit_tag "地図クイズをやめる", class: "btn btn--secondary", data: { turbo_confirm: "発見記録をリセットしますか？" } %>
      <% end %>
    </div>
  </div>
</div>
