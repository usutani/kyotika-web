<div class="container">
  <header class="header">
    <h1>ランドマーク編集</h1>
    <p class="subtitle"><%= @landmark.name %></p>
  </header>

  <% if @landmark.errors.any? %>
    <div class="error-messages">
      <h3><%= @landmark.errors.count %>件のエラーがあります</h3>
      <ul>
        <% @landmark.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with(model: @landmark, class: "landmark-form") do |f| %>
    <div class="form-group">
      <%= f.label :name, "名前" %>
      <%= f.text_field :name, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= f.label :hiragana, "読み" %>
      <%= f.text_field :hiragana, class: "form-control" %>
    </div>

    <div class="form-row">
      <div class="form-group half">
        <%= f.label :latitude, "緯度" %>
        <%= f.text_field :latitude, class: "form-control" %>
      </div>
      <div class="form-group half">
        <%= f.label :longitude, "経度" %>
        <%= f.text_field :longitude, class: "form-control" %>
      </div>
    </div>

    <div class="form-group">
      <%= f.label :url, "URL" %>
      <%= f.text_field :url, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= f.label :question, "問題" %>
      <%= f.text_area :question, class: "form-control", rows: 3 %>
    </div>

    <div class="form-row">
      <div class="form-group third">
        <%= f.label :answer1, "回答1" %>
        <%= f.text_field :answer1, class: "form-control" %>
      </div>
      <div class="form-group third">
        <%= f.label :answer2, "回答2" %>
        <%= f.text_field :answer2, class: "form-control" %>
      </div>
      <div class="form-group third">
        <%= f.label :answer3, "回答3" %>
        <%= f.text_field :answer3, class: "form-control" %>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group third">
        <%= f.label :correct, "正解 (1-3)" %>
        <%= f.number_field :correct, class: "form-control", min: 1, max: 3 %>
      </div>
      <div class="form-group two-thirds">
        <%= f.label :author, "著者" %>
        <%= f.text_field :author, class: "form-control" %>
      </div>
    </div>

    <div class="form-actions">
      <%= f.submit "更新", class: "btn btn-primary" %>
      <%= link_to "キャンセル", landmarks_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
