<div class="layout">
  <header class="page-header">
    <%= page_header_tag %>
    <p class="page-header__subtitle">京都のランドマーク一覧（<%= @landmarks.count %>件）<%= "：自分の登録分のみ表示" unless Current.user.administrator? %></p>
    <nav class="nav-links">
      <%= link_to "クイズ", quiz_path, class: "btn btn--nav" %>
      <%= link_to "タグ一覧", tags_path, class: "btn btn--nav" %>
      <% if Current.user.administrator? %>
        <%= link_to "無効なURL", invalid_urls_path, class: "btn btn--nav" %>
      <% end %>
      <%= link_to "追加", new_landmark_path, class: "btn btn--primary nav-links__right" %>
    </nav>
  </header>

  <div class="table">
    <% if @landmarks.any? %>
    <div data-controller="table-filter">
      <div class="form__group">
        <input type="text"
               class="form__control"
               placeholder="ランドマークを検索…"
               data-table-filter-target="input"
               data-action="input->table-filter#filter">
      </div>
      <table class="data-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>名前</th>
            <th>読み（ひらがな）</th>
            <th>正解</th>
            <th>登録者</th>
            <th></th>
          </tr>
        </thead>
        <tbody data-table-filter-target="list">
          <% @landmarks.each do |landmark| %>
            <tr data-search="<%= [ landmark.latitude, landmark.longitude, landmark.url, landmark.question, landmark.answer1, landmark.answer2, landmark.answer3 ].compact_blank.join(" ") %>">
              <td class="data-table__cell--num"><%= landmark.id %></td>
              <td class="data-table__cell--name"><%= landmark.name %></td>
              <td class="data-table__cell--hiragana"><%= landmark.hiragana %></td>
              <td class="data-table__cell--num"><%= landmark.correct %></td>
              <td><%= landmark.creator_label %></td>
              <td class="data-table__cell--action">
                <%= link_to "編集", edit_landmark_path(landmark), class: "btn btn--edit" %>
                <%= button_to "削除", landmark_path(landmark), method: :delete, class: "btn btn--delete",
                    data: { turbo_confirm: "本当に削除しますか？" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <p class="empty-message" data-table-filter-target="emptyMessage" style="display: none;">一致するランドマークがありません。</p>
    </div>
    <% else %>
      <% if Current.user.administrator? %>
        <p class="empty-message">登録がありません。「追加」から登録するか、seed を投入してください。</p>
      <% else %>
        <p class="empty-message">自分の登録はまだありません。「追加」から登録してください。</p>
      <% end %>
    <% end %>
  </div>
</div>
