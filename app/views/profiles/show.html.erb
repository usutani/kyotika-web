<div class="layout">
  <header class="page-header">
    <h1 class="page-header__title">プロフィール</h1>
    <p class="page-header__subtitle"><%= @user.email_address %></p>
  </header>

  <% if @user.errors.any? %>
    <div class="error-messages">
      <h3><%= @user.errors.count %>件のエラーがあります</h3>
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with(model: @user, url: profile_path, method: :patch, class: "form") do |f| %>
    <div class="form__group">
      <%= f.label :name, "名前" %>
      <%= f.text_field :name, class: "form__control", autocomplete: "name" %>
    </div>

    <div class="form__group">
      <%= f.label :current_password, "現在のパスワード（パスワード変更時のみ）" %>
      <%= f.password_field :current_password, class: "form__control", autocomplete: "current-password" %>
    </div>

    <div class="form__row">
      <div class="form__group form__group--half">
        <%= f.label :password, "新しいパスワード（8文字以上）" %>
        <%= f.password_field :password, class: "form__control", autocomplete: "new-password" %>
      </div>
      <div class="form__group form__group--half">
        <%= f.label :password_confirmation, "新しいパスワード（確認）" %>
        <%= f.password_field :password_confirmation, class: "form__control", autocomplete: "new-password" %>
      </div>
    </div>

    <div class="form__actions">
      <%= f.submit "更新", class: "btn btn--primary" %>
    </div>
  <% end %>
</div>
