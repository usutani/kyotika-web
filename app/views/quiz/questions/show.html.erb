<div class="layout">
  <header class="page-header">
    <%= page_header_tag %>
    <p class="page-header__subtitle">問題 <%= @index + 1 %> / <%= @total %></p>
  </header>

  <div class="quiz">
    <div id="quiz-progress" class="quiz__progress">
      <div class="quiz__progress-bar">
        <div class="quiz__progress-fill" style="width: <%= ((@index + 1).to_f / @total * 100).round %>%"></div>
      </div>
      <span class="quiz__progress-text">正解数: <%= @score %></span>
    </div>

    <div id="quiz-area">
      <div class="quiz__question">
        <p><%= @landmark.question %></p>
      </div>

      <div id="quiz-answers" class="quiz__answers">
        <% (1..3).each do |n| %>
          <%= form_with url: quiz_answer_path, method: :post, class: "quiz__answer-form" do |f| %>
            <%= f.hidden_field :landmark_id, value: @landmark.id, id: "quiz-landmark-id-#{n}" %>
            <%= f.hidden_field :selected, value: n, id: "quiz-selected-#{n}" %>
            <button type="submit" class="btn quiz__answer-btn"><%= @landmark.send("answer#{n}") %></button>
          <% end %>
        <% end %>
      </div>
    </div>
    <div class="quiz__next">
      <%= form_with url: quiz_path, method: :delete, class: "quiz__quit-form" do |f| %>
        <%= f.submit "クイズをやめる", class: "btn btn--secondary" %>
      <% end %>
    </div>
  </div>
</div>
