<div class="layout">
  <header class="page-header">
    <%= page_header_tag %>
    <p class="page-header__subtitle">クイズ結果</p>
  </header>

  <div class="quiz">
    <div class="quiz__score">
      <p class="quiz__score-number"><%= @score %> / <%= @total %></p>
      <div class="quiz__score-bar">
        <div class="quiz__score-fill" style="width: <%= (@total > 0 ? (@score.to_f / @total * 100).round : 0) %>%"></div>
      </div>
      <p class="quiz__score-percent">正解率 <%= @total > 0 ? (@score.to_f / @total * 100).round : 0 %>%</p>
    </div>

    <% if @answers.any? %>
      <div class="table">
        <table class="data-table">
          <thead>
            <tr>
              <th>#</th>
              <th>ランドマーク</th>
              <th>あなたの回答</th>
              <th>正解</th>
              <th class="data-table__cell--status">結果</th>
            </tr>
          </thead>
          <tbody>
            <% @answers.each_with_index do |answer, i| %>
              <tr class="<%= answer[:correct?] ? 'data-table__row--correct' : 'data-table__row--incorrect' %>">
                <td class="data-table__cell--num"><%= i + 1 %></td>
                <td class="data-table__cell--name"><%= answer[:name] %></td>
                <td><%= answer[:answer_text] || "-" %></td>
                <td><%= answer[:correct_answer_text] || "-" %></td>
                <td class="data-table__cell--status">
                  <% if answer[:correct?] %>
                    <span class="status-badge status-badge--valid">正解</span>
                  <% else %>
                    <span class="status-badge status-badge--invalid">不正解</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <div class="nav-links">
      <%= link_to "クイズトップに戻る", quiz_path, class: "btn btn--primary" %>
    </div>
  </div>
</div>
