<div class="layout">
  <header class="page-header">
    <h1 class="page-header__title">メンバー登録</h1>
    <p class="page-header__subtitle">招待URLから登録します</p>
  </header>

  <% if @user.errors.any? %>
    <div class="error-messages">
      <h3><%= @user.errors.count %>件のエラーがあります</h3>
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with(model: @user, url: join_path(join_code: params[:join_code]), class: "form") do |f| %>
    <div class="form__group">
      <%= f.label :name, "名前" %>
      <%= f.text_field :name, class: "form__control", autocomplete: "name" %>
    </div>

    <div class="form__group">
      <%= f.label :email_address, "メールアドレス" %>
      <%= f.email_field :email_address, class: "form__control", autocomplete: "email" %>
    </div>

    <div class="form__row">
      <div class="form__group form__group--half">
        <%= f.label :password, "パスワード（8文字以上）" %>
        <%= f.password_field :password, class: "form__control", autocomplete: "new-password" %>
      </div>
      <div class="form__group form__group--half">
        <%= f.label :password_confirmation, "パスワード（確認）" %>
        <%= f.password_field :password_confirmation, class: "form__control", autocomplete: "new-password" %>
      </div>
    </div>

    <div class="form__actions">
      <%= f.submit "登録", class: "btn btn--primary" %>
    </div>
  <% end %>
</div>
