<div class="layout">
  <header class="page-header">
    <h1 class="page-header__title">タグ追加</h1>
  </header>

  <% if @tag.errors.any? %>
    <div class="error-messages">
      <h3><%= @tag.errors.count %>件のエラーがあります</h3>
      <ul>
        <% @tag.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with(model: @tag, url: tags_path, class: "form") do |f| %>
    <div class="form__group">
      <%= f.label :name, "タグ名" %>
      <%= f.text_field :name, class: "form__control" %>
    </div>

    <div class="form__actions">
      <%= f.submit "追加", class: "btn btn--primary" %>
      <%= link_to "キャンセル", tags_path, class: "btn btn--secondary" %>
    </div>
  <% end %>
</div>
