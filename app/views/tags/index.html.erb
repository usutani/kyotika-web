<div class="layout">
  <header class="page-header">
    <%= page_header_tag %>
    <p class="page-header__subtitle">タグ一覧（<%= @tags.count %>件）</p>
    <nav class="nav-links">
      <%= link_to "ランドマーク一覧", landmarks_path, class: "btn btn--nav" %>
      <% if Current.user.administrator? %>
        <%= link_to "無効なURL", invalid_urls_path, class: "btn btn--nav" %>
      <% end %>
      <%= link_to "タグを追加", new_tag_path, class: "btn btn--primary nav-links__right" %>
    </nav>
  </header>

  <div class="table">
    <% if @tags.any? %>
    <div data-controller="table-filter">
      <div class="form__group">
        <input type="text"
               class="form__control"
               placeholder="タグを検索…"
               data-table-filter-target="input"
               data-action="input->table-filter#filter">
      </div>
      <table class="data-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>タグ名</th>
            <th>関連ランドマーク</th>
            <th></th>
          </tr>
        </thead>
        <tbody data-table-filter-target="list">
          <% @tags.each do |tag| %>
            <tr>
              <td class="data-table__cell--num"><%= tag.id %></td>
              <td class="data-table__cell--name"><%= tag.name %></td>
              <td class="data-table__cell--list"><%= tag.landmarks.map(&:name).join(", ") %></td>
              <td class="data-table__cell--action">
                <%= link_to "編集", edit_tag_path(tag), class: "btn btn--edit" %>
                <% if Current.user.administrator? %>
                  <%= button_to "削除", tag_path(tag), method: :delete, class: "btn btn--delete",
                      data: { turbo_confirm: "本当に削除しますか？" } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <p class="empty-message" data-table-filter-target="emptyMessage" style="display: none;">一致するタグがありません。</p>
    </div>
    <% else %>
      <p class="empty-message">タグはまだありません。「タグを追加」から登録してください。</p>
    <% end %>
  </div>
</div>
