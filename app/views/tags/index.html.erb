<div class="layout">
  <header class="page-header">
    <%= page_header_tag %>
    <p class="page-header__subtitle">タグ一覧（<%= @tags.count %>件）</p>
    <nav class="nav-links">
      <%= link_to "タグを追加", new_tag_path, class: "btn btn--nav" %>
      <%= link_to "ランドマーク一覧", landmarks_path, class: "btn btn--nav" %>
      <%= link_to "無効なURL", invalid_urls_path, class: "btn btn--nav" %>
    </nav>
  </header>

  <div class="table">
    <table class="data-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>タグ名</th>
          <th>関連ランドマーク</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @tags.each do |tag| %>
          <tr>
            <td class="data-table__cell--num"><%= tag.id %></td>
            <td class="data-table__cell--name"><%= tag.name %></td>
            <td class="data-table__cell--list"><%= tag.landmarks.map(&:name).join(", ") %></td>
            <td class="data-table__cell--action">
              <%= link_to "編集", edit_tag_path(tag), class: "btn btn--edit" %>
              <%= button_to "削除", tag_path(tag), method: :delete, class: "btn btn--delete",
                  data: { turbo_confirm: "本当に削除しますか？" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
